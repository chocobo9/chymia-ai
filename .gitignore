node_modules/
dist/
build/
coverage/
playwright-report/
test-results/
*.log
*.tsbuildinfo
.DS_Store
.state.txt
.harness_probe.txt
_tmp_*
# Codex conversation attachments are local ingestion cache, not project assets.
.codex-remote-attachments/
# transient test databases
*.db
*.db-shm
*.db-wal
*.sqlite
.tmp/
# Local runtime agent workspace (default CHOCO_WORKSPACE when unset) — runtime data, not source.
.workspace/
# Per-workspace gemini CLI config the engine writes (writeGeminiMcpSettings) so
# @gemini sees the choco MCP server — runtime-generated, not source.
.gemini/
# Runtime data dir: rolling logs (LOG_DIR) + persisted member-edit overrides
# (CHOCO_AGENT_OVERRIDES default data/agent-overrides.json). Runtime state, not source.
data/
# Third-party reference source (full Clowder codebase, ~117M) — used only as a
# WHY/edge-case reference per CLAUDE.md §0.3; NOT this project's deliverable and
# not ours to publish. Excluded from the repo.
reference/
# Orchestrator-internal scaffolding (build state, gate output, handoff log) — NOT for upload.
# Ignore everything under .harness EXCEPT the alignment-gate scripts, which must be
# version-controlled so CI (.github/workflows/alignment-gate.yml) can run them.
.harness/*
!.harness/check-alignment.mjs
!.harness/validate-commit.mjs
# Project governance / task spec — internal, not published.
CLAUDE.md
PROJECT_SPEC.md
# Chymia design documentation is tracked under docs/. Third-party reference
# material remains excluded by the reference/ rule above.
# Document and presentation production intermediates.
docs/architecture/*-debug.png
outputs/pptx-link-fix/
outputs/chymia-presentation/
outputs/*.inspect.ndjson
outputs/chymia-architecture.excalidraw
outputs/chymia-architecture-v2.excalidraw
outputs/chymia-architecture-interview.excalidraw
