{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .harness/check-alignment.mjs"
          }
        ]
      }
    ],
    "Stop": [
      { "matcher": "",
        "hooks": [
          { "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/scope_gate.py\"",
            "timeout": 10 } ] } ]
  },
  "permissions": {
    "allow": ["mcp__choco__*"]
  }
}
